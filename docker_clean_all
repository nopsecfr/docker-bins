#!/bin/bash

# Arrêter et supprimer tous les conteneurs (actifs et arrêtés)
sudo docker rm -f $(docker ps -aq) 2>/dev/null

# Supprimer tous les volumes (données persistantes)
sudo docker volume rm $(docker volume ls -q) 2>/dev/null

# Supprimer tous les réseaux non par défaut
sudo docker network prune -f

# Nettoyer le système en gardant explicitement les images (-a n'est pas utilisé ici pour les images)
sudo docker system prune --volumes -f

# Nettoyer le cache de build
sudo docker builder prune -a -f
